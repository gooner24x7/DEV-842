{
    "name": "ntuk/dashboard",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/laravel-boq-allocator",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/arquivei/laravel-prometheus-exporter"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-redis": "*",
        "arquivei/laravel-prometheus-exporter": "*",
        "ayles-software/laravel-zoho-desk": "*",
        "barryvdh/laravel-dompdf": "^2.2",
        "bnbwebexpertise/laravel-attachments": "*",
        "construction/boq-allocator": "@dev",
        "doctrine/dbal": "^3.0",
        "geocoder-php/bing-maps-provider": "*",
        "geocoder-php/google-maps-provider": "*",
        "geocoder-php/yandex-provider": "*",
        "google/apiclient": "^2.12",
        "guzzlehttp/guzzle": "^7.4",
        "karkowg/php-mupdf": "^2.0",
        "laravel/cashier": "^12.11",
        "laravel/framework": "^9.0",
        "laravel/socialite": "^5.26",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^3.0",
        "mbezhanov/faker-provider-collection": "*",
        "orhanerday/open-ai": "^5.1",
        "phpoffice/phpspreadsheet": "^2.2",
        "sebastian/phpcpd": "*",
        "socialiteproviders/microsoft": "^4.9",
        "socialiteproviders/microsoft-graph": "^4.1",
        "spatie/pdf-to-image": "^3.1",
        "spatie/pdf-to-text": "*",
        "toin0u/geocoder-laravel": "*",
        "tymon/jwt-auth": "*",
        "zohocrm/php-sdk-2.0": "*"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan cache:clear"
        ],
        "post-install-cmd": [
            "@php artisan cache:clear"
        ]
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "3.16.0",
        "kwn/php-rdkafka-stubs": "*",
        "mockery/mockery": "*",
        "nunomaduro/collision": "^7.10",
        "overtrue/phplint": "^9.3",
        "phpmd/phpmd": "*",
        "phpunit/phpunit": "^9.6",
        "spatie/laravel-ignition": "*",
        "squizlabs/php_codesniffer": "*"
    }
}
